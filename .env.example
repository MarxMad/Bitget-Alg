# ─────────────────────────────────────────────────────────────────────────────
#  Bitget-Algoritmo-API · variables de entorno
#  1) Copia este archivo:   cp .env.example .env
#  2) Llena tus valores en .env (NUNCA en este archivo, que sí se sube a GitHub)
#  Guía paso a paso: guias/02-api-key-demo.md
# ─────────────────────────────────────────────────────────────────────────────

# 1 = modo DEMO (fondos simulados, Demo API key). Déjalo en 1 durante el taller.
BITGET_DEMO=1

# Los tres datos que Bitget te muestra al crear la API key
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=

# Símbolo para herramientas/check_conexion.py
BITGET_TEST_SYMBOL=BTCUSDT

# ── Avanzado: llave RSA en lugar de secret (deja BITGET_SECRET_KEY vacío) ────
# BITGET_PRIVATE_KEY_PATH=/ruta/a/tu/llave_privada.pem
