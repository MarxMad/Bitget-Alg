# Copy to .env and fill in. .env is gitignored — keep it that way.
BITGET_ACCESS_KEY=bg_your_access_key_here
BITGET_PASSPHRASE=your_passphrase_here

# Either a path to the PEM file, or the PEM text itself (for Vercel/Railway envs)
BITGET_PRIVATE_KEY_PATH=/absolute/path/to/bitget_private_key.pem
# BITGET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Vercel cron only
CRON_SECRET=generate_with_openssl_rand_hex_32
TRADING_MODE=paper
